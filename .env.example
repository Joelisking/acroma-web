# Acroma Web — environment variables

# URL of the Acroma backend (NestJS API).
# Server-only — used by Next.js Server Components and Server Actions.
# Local dev: http://localhost:3006
# Phone/external testing: use the same ngrok URL the mobile app uses.
ACROMA_API_URL=http://localhost:3006

# Socket.IO endpoint. Usually the same as ACROMA_API_URL.
# This one IS exposed to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_ACROMA_SOCKET_URL=http://localhost:3006

# Cookie security. Set to "true" in production (https only).
COOKIE_SECURE=false

# Cloudinary — unsigned direct uploads. Same cloud + preset the mobile app
# uses, so a single asset library covers both clients.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Backend-only (set in the acroma-backend project's .env, not here):
#
#   DATABASE_URL=postgresql://…
#   JWT_SECRET=…
#   JWT_REFRESH_SECRET=…
#   ANTHROPIC_API_KEY=sk-ant-…
#   API_URL=…   (the backend's own public URL, used in webhooks etc.)
#   WEB_URL=…   (the web app's URL, used in email CTAs)
#
#   META_APP_ID=…
#   META_APP_SECRET=…  (for WhatsApp Embedded Signup — currently deferred)
#
#   RESEND_API_KEY=re_…
#   RESEND_FROM=Acroma <notifications@asera.tech>
#   (the from-domain must be verified in Resend before prod sends work)
# ---------------------------------------------------------------------------
